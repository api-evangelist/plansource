{
  "opencollection": "1.0.0",
  "info": {
    "name": "Plansource Admin Administrators API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.plansource.com/oauth/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Administrators",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /administrator",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.plansource.com/admin/v2/administrator",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an administrator."
        },
        {
          "info": {
            "name": "GET /administrator/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plansource.com/admin/v2/administrator/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the administrator to fetch."
              }
            ]
          },
          "docs": "Retrieve data for an administrator."
        },
        {
          "info": {
            "name": "PUT /administrator/{id}",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.plansource.com/admin/v2/administrator/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the administrator to update. The API currently uses the payload's user_name to look up the administrator."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update data for an administrator."
        },
        {
          "info": {
            "name": "PUT /administrator/{id}/disable",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.plansource.com/admin/v2/administrator/:id/disable",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the administrator to update or 1.The API currently uses the payload's user_name to look up the administrator."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Disable an administrator account."
        },
        {
          "info": {
            "name": "GET /administrators",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.plansource.com/admin/v2/administrators",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Set to page number.  Large responses are parsed into a maximum of 500 administrators or the per_page value for large responses of administrators."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Override of the maximum of 500 administrators returned in a response."
              },
              {
                "name": "changes_since",
                "value": "",
                "type": "query",
                "description": "Will only return admins whose updated_at timestamp is within the number of minutes of the change_since value."
              }
            ]
          },
          "docs": "Retrieve data for all administrators."
        }
      ]
    }
  ],
  "bundled": true
}